{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadatastician.github.io/phi-LAM/contracts/v1/protocol.schema.json",
  "title": "phi-LAM operational boundary protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/lifecycle_event" },
    { "$ref": "#/$defs/request_snapshot" },
    { "$ref": "#/$defs/queue_delivery" },
    { "$ref": "#/$defs/queue_ack" },
    { "$ref": "#/$defs/adapter_result" },
    { "$ref": "#/$defs/sandbox_request" },
    { "$ref": "#/$defs/sandbox_result" },
    { "$ref": "#/$defs/inference_request" },
    { "$ref": "#/$defs/inference_result" }
  ],
  "$defs": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "core_id", "payload"],
      "properties": {
        "type": { "const": "request" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" },
        "core_id": { "type": "integer", "minimum": 0 },
        "payload": { "type": "object" }
      }
    },
    "lifecycle_event": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "event_id", "request_id", "sequence", "kind"],
      "properties": {
        "type": { "const": "lifecycle_event" }, "protocol_version": { "const": 1 },
        "event_id": { "$ref": "#/$defs/request_id" }, "request_id": { "$ref": "#/$defs/request_id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["accepted", "started", "effect_committed", "completed", "failed_before_commit", "ambiguous_after_effect", "retry_requested"] }
      }
    },
    "request_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "core_id", "sequence", "state"],
      "properties": {
        "type": { "const": "request_snapshot" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" }, "core_id": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["accepted", "started", "effect_committed", "completed", "failed_before_commit", "ambiguous_after_effect"] }
      }
    },
    "queue_delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "delivery_id", "request_id", "attempt"],
      "properties": {
        "type": { "const": "queue_delivery" }, "protocol_version": { "const": 1 },
        "delivery_id": { "$ref": "#/$defs/request_id" }, "request_id": { "$ref": "#/$defs/request_id" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "queue_ack": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "delivery_id", "request_id", "disposition"],
      "properties": {
        "type": { "const": "queue_ack" }, "protocol_version": { "const": 1 },
        "delivery_id": { "$ref": "#/$defs/request_id" }, "request_id": { "$ref": "#/$defs/request_id" },
        "disposition": { "enum": ["acknowledged", "retry", "dead_letter"] }
      }
    },
    "adapter_result": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "disposition"],
      "properties": {
        "type": { "const": "adapter_result" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" },
        "disposition": { "enum": ["committed", "rejected_before_effect", "ambiguous_after_effect"] },
        "receipt": { "type": "string" }
      }
    },
    "sandbox_request": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "operation", "granted_capabilities"],
      "properties": {
        "type": { "const": "sandbox_request" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" },
        "operation": { "enum": ["filesystem_read", "filesystem_write", "network", "spawn_process"] },
        "granted_capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["filesystem_read", "filesystem_write", "network", "spawn_process"] } }
      }
    },
    "sandbox_result": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "decision"],
      "properties": {
        "type": { "const": "sandbox_result" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" }, "decision": { "enum": ["allow", "deny"] }
      }
    },
    "inference_request": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "features"],
      "properties": {
        "type": { "const": "inference_request" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" },
        "features": { "type": "array", "minItems": 1, "items": { "type": "number" } }
      }
    },
    "inference_result": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "model", "score"],
      "properties": {
        "type": { "const": "inference_result" }, "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/request_id" }, "model": { "const": "fixture-mean-v1" },
        "score": { "type": "number" }
      }
    }
  }
}
